      "name": "V1",
      "description": {
        "content": "Operations allowing export of survey data",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7bb138ec-8c75-43eb-bf28-478b9f0ae027",
          "name": "Retrieve Responses",
          "request": {
            "name": "Retrieve Responses",
            "description": {
              "content": "Use this endpoint to retrieve responses from your studies. This endpoint allows you to retrieve up to 1000 responses at a time.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "responses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<integer>",
                  "description": "The earliest creation data for a generated theme to return, represented as milliseconds from epoch time"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<integer>",
                  "description": "The latest creation date for a generated theme to return, represented as milleseconds from epoch time"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "A Base64 encoded string representing an opaque cursor position"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Specific number of results to return"
                },
                {
                  "disabled": false,
                  "key": "sid",
                  "value": "<integer>",
                  "description": "An integer id for a specific Survey"
                },
                {
                  "disabled": false,
                  "key": "with_snapshots",
                  "value": "<boolean>",
                  "description": "true/false(default). If true, the API will return visitorSnapshots, which contains all events, attributes, triggeringEvent, and eventProperties set for the visitor at the time of survey delivery."
                },
                {
                  "disabled": false,
                  "key": "with_urls",
                  "value": "<boolean>",
                  "description": "true/false (default). If true, the API will return the page URL from which the survey was taken."
                },
                {
                  "disabled": false,
                  "key": "with_meta",
                  "value": "<boolean>",
                  "description": "true/false (default). If true, the API will return the metadata JSON blob containing details available from the client."
                },
                {
                  "disabled": false,
                  "key": "with_custom_metadata",
                  "value": "<boolean>",
                  "description": "true/false (default). If true, the API will return any custom metadata associated with the response (applicable to link platform surveys only)."
                },
                {
                  "disabled": false,
                  "key": "with_deleted_responses",
                  "value": "<boolean>",
                  "description": "true/false (default). If true, the API will return the responses that have been previously deleted."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
