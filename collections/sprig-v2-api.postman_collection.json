          "name": "Retrieve a User",
          "request": {
            "name": "Retrieve a User",
            "description": {
              "content": "Endpoint that allows the retrieval of a visitor based on a known User ID.\nThis endpoint can only recover visitors with user IDs, so please ensure your Sprig implementation has user tracking configured correctly based on your SDK installation: /docs/Installation/introduction-web/index\nThis endpoint will retrieve visitor info, a list of attributes tied to the visitor, and a list of events with relevant filter criteria.",
              "type": "text/plain"
            },
