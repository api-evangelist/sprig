        {
          "id": "d430c2b3-598b-4e90-bb42-c91f97274b4e",
          "name": "Purge Visitors",
          "request": {
            "name": "Purge Visitors",
            "description": {
              "content": "The Purge Visitors API helps teams comply with end-user bulk data deletion requests mandated by laws like GDPR and CCPA. This endpoint will delete users and all related user data identified by a set of emails, visitor IDs, or user IDs.\n\nPurge requests default to being processed 10 days after submission, however this delay can be configured via the delaySeconds parameter. The endpoint is limited to 100 visitor deletions per request.\n\nOne of email, userId, or visitorId parameter is required to identify the user for data deletion.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "purge",
                "visitors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delaySeconds\": \"<integer>\",\n  \"emails\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"userIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"visitorIds\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
