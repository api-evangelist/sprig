          "name": "Upsert a User",
          "request": {
            "name": "Upsert a User",
            "description": {
              "content": "Endpoint facilitating the programatic upsertion of a user.\nUsers must be upserted 1 at a time.\nEvents created for this user are for historical tracking purposes. Any event tied to a user through this endpoint will not trigger a study through Sprig's SDK.\nAttributes and attribute values can be created and tied to a user through this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
